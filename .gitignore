# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Node / Next
node_modules/
.next/
out/
dist/
build/
coverage/
.turbo/
.cache/

# Env / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db

# Firebase / Vercel
.firebase/
.vercel/

# Large binaries / archives
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.iso

# If you accidentally copied a Node distribution
node-v*/
